/**
 * generate-native-mela-schedule.mts
 *
 * Generates the typed offline Kumbh / mela schedule snapshot for shoonaya-mobile.
 * Source of truth: packages/dharma-rules/src/melas/mela-schedule.json (dates and
 * text transcribed from the state Mela authorities' official websites).
 * Target: shoonaya-mobile/lib/mela-schedule.generated.ts
 */

import { readFileSync, writeFileSync, existsSync } from 'node:fs';
import { resolve, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

const __dirname = dirname(fileURLToPath(import.meta.url));
const sourcePath = resolve(__dirname, '../packages/dharma-rules/src/melas/mela-schedule.json');

const candidateTargetPaths = [
  resolve(__dirname, '../../../shoonaya-mobile/lib/mela-schedule.generated.ts'),
  resolve('/Users/Business(C)/shoonaya-mobile/lib/mela-schedule.generated.ts'),
];
const targetPath = candidateTargetPaths.find((p) => existsSync(dirname(p))) ?? candidateTargetPaths[1];

const jsonContent = JSON.parse(readFileSync(sourcePath, 'utf-8'));

const tsOutput = `/**
 * AUTOGENERATED FILE — DO NOT EDIT DIRECTLY.
 *
 * Generated by backend scripts/generate-native-mela-schedule.mts from
 * packages/dharma-rules/src/melas/mela-schedule.json.
 *
 * Kumbh and other melas are dated by the state Mela authorities with the
 * akharas, not by the calendar engine. Every date and text field here is
 * transcribed from their official websites and cites them. Clients render
 * these dates; they never calculate them, and never show an unconfirmed day.
 */

import type { LocalizedEditorialField } from './observance-series-contract.generated';

export type MelaDayKind = 'snan' | 'amrit_snan' | 'principal_amrit_snan' | 'event';

export interface MelaDay {
  date: string;
  title: string;
  kind: MelaDayKind;
  place: string;
  status: 'confirmed' | 'unconfirmed';
  note?: string;
}

export interface Mela {
  slug: string;
  tradition: string;
  emoji: string;
  timezone: string;
  periodStart: string | null;
  periodEnd: string | null;
  officialUrl: string;
  name: LocalizedEditorialField<{ en: string; hi?: string; pa?: string }>;
  tagline: LocalizedEditorialField<{ en: string; hi?: string; pa?: string }>;
  significance: LocalizedEditorialField<{ en: string; hi?: string; pa?: string }>;
  places: LocalizedEditorialField<{ en: string[]; hi?: string[]; pa?: string[] }>;
  rituals: LocalizedEditorialField<{ en: string[]; hi?: string[]; pa?: string[] }>;
  guidance?: LocalizedEditorialField<{ en: string[]; hi?: string[]; pa?: string[] }>;
  days: MelaDay[];
}

export interface MelaScheduleSnapshot {
  version: string;
  accessedOn: string;
  melas: Mela[];
}

export const MELA_SCHEDULE_SNAPSHOT: MelaScheduleSnapshot = ${JSON.stringify(jsonContent, null, 2)} as MelaScheduleSnapshot;
`;

writeFileSync(targetPath, tsOutput, 'utf-8');
console.log(`Generated Native mela schedule snapshot at ${targetPath}`);
