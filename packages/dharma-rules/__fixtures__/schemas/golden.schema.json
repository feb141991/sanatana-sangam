{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shoonaya.app/schemas/fixture/golden/v1",
  "title": "GoldenFixture",
  "description": "Schema for a sourced golden fixture in __fixtures__/golden/. Every field must be present. Expected values assert CORRECTNESS against a cited Tier 1-4 source.",
  "type": "object",
  "required": [
    "caseId",
    "festivalId",
    "year",
    "location",
    "profile",
    "expected",
    "tolerance",
    "source",
    "reasoning",
    "approved"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "caseId": {
      "type": "string",
      "description": "Unique identifier, e.g. maha_shivaratri__bedford__2027__purnimanta_smarta",
      "pattern": "^[a-z0-9_\\-]+$"
    },
    "festivalId": {
      "type": "string",
      "description": "The slug of the observance definition, matching the CANONICAL_RULES slug"
    },
    "year": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2100
    },
    "location": {
      "type": "object",
      "required": ["label", "lat", "lon", "tz"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "tz": { "type": "string", "description": "IANA timezone identifier, e.g. Asia/Kolkata" }
      }
    },
    "profile": {
      "type": "object",
      "required": ["calendar", "tradition"],
      "additionalProperties": false,
      "properties": {
        "calendar": {
          "description": "A calendar_profiles slug, or null for rules with no amanta/purnimanta/solar axis at all (solar_fixed, relative_to_other_observance, regional_calendar -- e.g. Sikh Nanakshahi rules, which have no month system for a profile to ratify).",
          "type": ["string", "null"],
          "enum": [
            "north_indian_purnimanta",
            "gujarati_amanta",
            "marathi_amanta",
            "kannada_amanta",
            "telugu_amanta",
            "kannada_telugu_amanta",
            "tamil_solar",
            "malayalam_solar",
            "bengali_solar",
            "odia",
            "nepali_bikram",
            "global_sanatan",
            "legacy-ujjain",
            null
          ]
        },
        "tradition": {
          "type": "string",
          "enum": ["smarta", "gaudiya_iskcon", "sri_vaishnava", "swaminarayan", "shaiva", "shakta", "unspecified", "all", "sikh", "buddhist", "jain"]
        },
        "variantKey": {
          "type": "string",
          "description": "Optional variant key for disputed / sampradaya variants, e.g. smarta, vaishnava_vidhava"
        }
      }
    },
    "expected": {
      "description": "The expected output. Values may be null when not yet verified (approved: false). NEVER populate from model output — requires a Tier 1-4 cited source.",
      "oneOf": [
        {
          "type": "object",
          "required": ["civilDate"],
          "additionalProperties": false,
          "properties": {
            "civilDate": {
              "type": ["string", "null"],
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "monthLabel": { "type": ["string", "null"] },
            "windows": {
              "type": ["object", "null"],
              "additionalProperties": {
                "type": "object",
                "required": ["startLocal", "endLocal"],
                "properties": {
                  "startLocal": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" },
                  "endLocal": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" }
                }
              }
            },
            "reasonCodes": {
              "type": ["array", "null"],
              "items": { "type": "string" }
            },
            "alternativeCount": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        { "type": "null" }
      ]
    },
    "tolerance": {
      "type": "object",
      "required": ["windowMinutes"],
      "additionalProperties": false,
      "properties": {
        "windowMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60,
          "description": "Tolerance in minutes for window start/end comparisons. Dates always compare exactly."
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["tier", "ref", "citation", "verifiedBy", "verifiedOn"],
      "additionalProperties": false,
      "properties": {
        "tier": {
          "type": "integer",
          "enum": [1, 2, 3, 4],
          "description": "Source tier per source-governance.md §2. Tier 5 (digital services) and Tier 6 (LLM output) are NOT valid golden sources."
        },
        "ref": { "type": "string", "description": "Identifier in source_references table or a descriptive key" },
        "citation": { "type": "string", "description": "Human-readable bibliographic reference" },
        "verifiedBy": { "type": "string", "description": "council ID or scholar identifier" },
        "verifiedOn": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "ISO date when this fixture was reviewed against the cited source"
        }
      }
    },
    "reasoning": {
      "type": "string",
      "description": "Human-readable explanation of why the engine should produce this result"
    },
    "approved": {
      "type": "boolean",
      "description": "True only after council sign-off AND the source has been verified. Files with approved: false exist as placeholders for human verification."
    }
  }
}
