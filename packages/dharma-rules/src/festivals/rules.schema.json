{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ObservanceRulesSchema",
  "description": "Schema for validating canonical calendar observance rules (Layer C)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "slug",
      "display_name",
      "emoji",
      "description",
      "kind",
      "tradition",
      "rule_family",
      "verification_type"
    ],
    "properties": {
      "sampradaya": {
        "type": "string",
        "enum": [
          "smarta",
          "smarta_nishita",
          "gaudiya_iskcon",
          "sri_vaishnava",
          "swaminarayan",
          "vaishnava_suddha",
          "vaishnava_rohini",
          "vaishnava_strict",
          "standard"
        ],
        "description": "Sampradaya (tradition sub-group) for variant distinctions"
      },
      "citation": {
        "type": "string",
        "description": "Citation/source for the observed variant practice"
      },
      "slug": {
        "type": "string",
        "description": "Unique identifier of the observance rule"
      },
      "display_name": {
        "type": "string",
        "description": "Human readable name of the observance"
      },
      "emoji": {
        "type": "string",
        "description": "Emoji representing the observance visually"
      },
      "description": {
        "type": "string",
        "description": "Short description of the festival's meaning"
      },
      "kind": {
        "type": "string",
        "enum": [
          "major",
          "vrat",
          "regional"
        ]
      },
      "tradition": {
        "type": "string",
        "enum": [
          "hindu",
          "sikh",
          "buddhist",
          "jain",
          "all"
        ]
      },
      "rule_family": {
        "type": "string",
        "enum": [
          "solar_fixed",
          "lunar_tithi",
          "lunar_tithi_recurring",
          "weekday_recurring",
          "relative_to_other_observance",
          "nakshatra_based",
          "regional_calendar",
          "solar_sankranti",
          "solar_month_day",
          "lunar_tithi_span"
        ]
      },
      "verification_type": {
        "type": "string",
        "enum": [
          "solar_fixed",
          "lunar_tithi",
          "nakshatra_based",
          "regional_calendar",
          "historical_commemoration",
          "solar_sankranti",
          "solar_month_day",
          "lunar_tithi_span"
        ]
      },
      "span_tithis": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "description": "Sequence of tithis (1-15 Shukla, 16-30 Krishna) spanned by a lunar_tithi_span rule"
      },
      "cluster_slug": {
        "type": "string",
        "description": "Optional parent cluster slug grouping multi-day observances"
      },
      "sub_observances": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "tithi",
            "slug",
            "display_name"
          ],
          "properties": {
            "tithi": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "description": "Tithi index within the span"
            },
            "slug": {
              "type": "string",
              "description": "Unique identifier of the sub-observance"
            },
            "display_name": {
              "type": "string",
              "description": "Human readable name of the sub-observance"
            },
            "emoji": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "devi_form": {
              "type": "string"
            },
            "rituals": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "enum": [
                "major",
                "vrat",
                "regional"
              ]
            },
            "launch_status": {
              "type": "string",
              "enum": [
                "included",
                "deferred"
              ]
            },
            "citation": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "description": "Named daily sub-observances within a lunar_tithi_span rule"
      },
      "solar_month": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12,
        "description": "Month of the Gregorian/Solar year (1-12)"
      },
      "solar_day": {
        "type": "integer",
        "minimum": 1,
        "maximum": 31,
        "description": "Day of the Gregorian/Solar month (1-31)"
      },
      "sankranti_rashi_index": {
        "type": "integer",
        "minimum": 0,
        "maximum": 11,
        "description": "0=Mesha..11=Meena sidereal rashi index for solar_sankranti rules"
      },
      "solar_month_profile": {
        "type": "string",
        "enum": ["tamil", "malayalam", "bengali", "odia"],
        "description": "Regional solar-calendar profile for solar_month_day rules"
      },
      "solar_month_target_rashi": {
        "type": "integer",
        "minimum": 0,
        "maximum": 11,
        "description": "0=Mesha..11=Meena -- which solar month (by rashi) a solar_month_day rule falls in"
      },
      "solar_month_day_of_month": {
        "type": "integer",
        "minimum": 1,
        "maximum": 32,
        "description": "1-based day within the solar month for solar_month_day rules (1 = new year / month-start day)"
      },
      "lunar_tithi_index": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30,
        "description": "Absolute index of the tithi (1-15 Shukla, 16-30 Krishna)"
      },
      "lunar_masa_name": {
        "type": "string",
        "description": "Calibrated legacy month name for D1 engine"
      },
      "nanakshahi_month": {
        "type": "string",
        "description": "Month name in the Nanakshahi calendar"
      },
      "nanakshahi_day": {
        "type": "integer",
        "minimum": 1,
        "maximum": 31,
        "description": "Day of the month in the Nanakshahi calendar"
      },
      "relative_base_slug": {
        "type": "string",
        "description": "Slug of the reference festival this rule is offset from"
      },
      "relative_offset_days": {
        "type": "integer",
        "description": "Offset in days from relative_base_slug"
      },
      "nakshatra_name": {
        "type": "string",
        "description": "Required nakshatra name"
      },
      "prefer_last_match": {
        "type": "boolean",
        "description": "Prefer later matching tithi in double-match cases"
      },
      "allow_skipped_tithi": {
        "type": "boolean",
        "description": "Allow matching skipped tithis on subsequent day"
      },
      "recurring_tithi_indices": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "description": "Indices of recurring tithis (e.g. for Ekadashi/Sankashti)"
      },
      "recurring_weekday": {
        "type": "integer",
        "minimum": 0,
        "maximum": 6,
        "description": "Vedic day weekday: 0=Sunday, 1=Monday... 6=Saturday"
      },
      "route_kind": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "vrat",
          null
        ]
      },
      "route_slug": {
        "type": [
          "string",
          "null"
        ]
      },
      "region": {
        "type": [
          "string",
          "null"
        ]
      },
      "corrected_lunar_masa_name": {
        "type": "string",
        "description": "Amanta lunar month name for D2 engine"
      },
      "corrected_lunar_tithi_index": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30,
        "description": "Corrected absolute tithi index"
      },
      "corrected_month_system": {
        "type": "string",
        "enum": [
          "amanta",
          "purnimanta"
        ],
        "description": "Lunisolar month naming system used by corrected engine"
      },
      "adhika_policy": {
        "type": "string",
        "enum": [
          "nija",
          "adhika",
          "both"
        ],
        "description": "Handling of Adhika (intercalary) month"
      },
      "corrected_prefer_last_match": {
        "type": "boolean",
        "description": "Corrected prefer_last_match flag"
      },
      "corrected_allow_skipped_tithi": {
        "type": "boolean",
        "description": "Corrected allow_skipped_tithi flag"
      },
      "tithi": {
        "type": "integer",
        "minimum": 1,
        "maximum": 15,
        "description": "Within-paksha canonical tithi index (1-15)"
      },
      "paksha": {
        "type": "string",
        "enum": [
          "shukla",
          "krishna"
        ],
        "description": "Required paksha for within-paksha tithi"
      },
      "variant_key": {
        "type": "string",
        "description": "Identity key of variant (e.g. smarta, vaishnava_vidhava)"
      },
      "skipped_tithi_policy": {
        "type": "string",
        "enum": [
          "previous_day",
          "following_day",
          "day_before",
          "day_after"
        ],
        "description": "Kshaya-tithi observance policy: previous_day (day before sunrise skip) or following_day (day after sunrise skip)"
      },
      "corrected_skipped_tithi_policy": {
        "type": "string",
        "enum": [
          "previous_day",
          "following_day",
          "day_before",
          "day_after"
        ],
        "description": "Corrected engine kshaya-tithi observance policy"
      },
      "corrected_tithi_reference_time": {
        "type": "string",
        "enum": [
          "sunrise",
          "madhyahna"
        ],
        "description": "D34: which instant of the civil day determines the prevailing tithi (corrected engine only). Undefined/sunrise is the default; madhyahna (solar noon) is a real dharma-sastra convention a handful of rules use instead."
      },
      "variant_id": {
        "type": "string",
        "description": "Identity of variant (e.g. smarta, vaishnava)"
      },
      "calendar_profile": {
        "type": "string",
        "description": "Profile compatibility context"
      },
      "spiritual_tradition": {
        "type": "string",
        "description": "Tradition compatibility context"
      },
      "ratified": {
        "type": "boolean",
        "description": "Scholar Advisory Council [S] ratification flag"
      },
      "review": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "technical_ok",
              "in_review",
              "approved",
              "disputed"
            ]
          },
          "reviewedBy": {
            "type": "string"
          },
          "effectiveFrom": {
            "type": "string"
          },
          "lastReviewed": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "derivability": {
        "type": "string",
        "enum": [
          "computed",
          "requires_tradition_profile",
          "externally_curated"
        ],
        "description": "Whether this observance's date can be derived by the engine at all. Absent means 'computed' -- the normal case. 'requires_tradition_profile': genuinely computable, but only under a calendar profile Shoonaya does not yet ship (e.g. Sri Lankan / Thai / Burmese Theravada). The amanta and purnimanta profiles are not authoritative for such observances, so their disagreement says nothing about the observance -- only about our coverage. 'externally_curated': not derivable by ANY calendar, because the date is chosen by an institution rather than computed (e.g. Kathina, where each monastery picks its own day within the month-long season after Pavarana). No future profile will fix this; the date has to come from outside."
      },
      "derivability_note": {
        "type": "string",
        "description": "Why this derivability applies, with sources where known."
      },
      "launch_status": {
        "type": "string",
        "enum": [
          "included",
          "deferred"
        ],
        "description": "Whether this observance ships in the launch set. Distinct from `derivability`: deferred means capable but not chosen, where a non-computed derivability means not knowable at all. Both suppress publication; only one is a scheduling decision."
      },
      "ratification_note": {
        "type": "string",
        "description": "Record of a council ruling on this rule's date, including rulings that REJECTED an engine-proposed change. Kept in the rule itself so the reasoning travels with the data rather than living only in a tracker someone has to remember to read."
      },
      "disputed_years": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2200
        },
        "uniqueItems": true,
        "description": "Years whose computed date is contested and is withheld from publication. Enforced by isPublishableForYear(); unlike ratification_note this is read by code."
      },
      "disputed_variants": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "variant_key": {
              "type": "string"
            },
            "spiritual_tradition": {
              "type": "string",
              "description": "Optional tradition profile when variant_key alone does not identify the recognised reading"
            },
            "civil_date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "source_ref": {
              "type": "string"
            },
            "review_status": {
              "type": "string"
            }
          },
          "required": [
            "variant_key",
            "civil_date",
            "source_ref",
            "review_status"
          ],
          "additionalProperties": false
        },
        "description": "Structured metadata for recognised variant dates when a year is disputed."
      }
    },
    "additionalProperties": false
  }
}
