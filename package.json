{
  "name": "shoonaya",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "validate:rules": "npx tsx scripts/validate-rules.ts",
    "prebuild": "npx tsx scripts/validate-rules.ts && npm run build --workspace=@sangam/panchang-engine && npm run build --workspace=@sangam/pramana-core && npm run build --workspace=@sangam/pramana-serve && npm run build --workspace=@sangam/pramana-eval",
    "prepare": "npm run build --workspace=@sangam/panchang-engine && npm run build --workspace=@sangam/pramana-core && npm run build --workspace=@sangam/pramana-serve && npm run build --workspace=@sangam/pramana-eval",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "compare:gita-retrieval": "npx tsx scripts/compare_retrieval.ts",
    "compare:upanishads-retrieval": "npx tsx scripts/compare_upanishads_retrieval.ts",
    "compare:gurbani-retrieval": "npx tsx scripts/compare_gurbani_retrieval.ts",
    "compare:buddhist-retrieval": "npx tsx scripts/compare_buddhist_retrieval.ts",
    "compare:jain-retrieval": "npx tsx scripts/compare_jain_retrieval.ts",
    "eval:run": "PYTHONPATH=python/ai_pipeline/src python3 -m ai_pipeline.evals.run_evals",
    "eval:compare": "PYTHONPATH=python/ai_pipeline/src python3 -m ai_pipeline.evals.compare_providers",
    "eval:compare:self-hosted": "PYTHONPATH=python/ai_pipeline/src python3 -m ai_pipeline.evals.compare_providers --modes mock hosted self-hosted",
    "corpus:build-indexes": "PYTHONPATH=python/ai_pipeline/src python3 -m ai_pipeline.embeddings.build_embeddings",
    "corpus:validate-indexes": "PYTHONPATH=python/ai_pipeline/src python3 -m ai_pipeline.embeddings.validate_indexes",
    "diagnostics": "PYTHONPATH=python/ai_pipeline/src python3 -m ai_pipeline.diagnostics.pramana_status",
    "diagnostics:json": "PYTHONPATH=python/ai_pipeline/src python3 -m ai_pipeline.diagnostics.pramana_status --json-only",
    "diagnostics:warn": "PYTHONPATH=python/ai_pipeline/src python3 -m ai_pipeline.diagnostics.pramana_status --fail-on-warn",
    "diagnostics:dashboard": "PYTHONPATH=python/ai_pipeline/src python3 -m ai_pipeline.diagnostics.generate_markdown_dashboard",
    "generate:splash": "npx tsx scripts/generate-splash.ts",
    "minify:static-html": "node scripts/minify-static-html.mjs",
    "test:indexnow": "node --test scripts/submit-indexnow.test.mjs",
    "verify:calendar": "npm run build --workspace=@sangam/panchang-engine && npm run verify:calendar --workspace=@sangam/dharma-rules",
    "verify:harness": "npm run build --workspace=@sangam/panchang-engine && npm run verify:harness --workspace=@sangam/dharma-rules",
    "generate:snapshots": "npm run generate:snapshots --workspace=@sangam/dharma-rules",
    "generate:golden-placeholders": "npx tsx packages/dharma-rules/scripts/generate-golden-placeholders.ts",
    "demo:d15-lock-override": "npx tsx scripts/demo-d15-lock-override.ts",
    "adjudicate-conditions": "npx tsx scripts/adjudicate-conditions.ts",
    "diff:masa-correction": "npx tsx scripts/diff-masa-correction.ts",
    "reconcile:engines": "npx tsx scripts/reconcile-engines.ts",
    "fixtures:usno-queries": "npx tsx scripts/usno-queries.ts",
    "fixtures:tier1-queries": "npx tsx scripts/tier1-queries.ts",
    "fixtures:coverage": "npx tsx scripts/fixture-coverage.ts",
    "fixtures:fetch": "npx tsx scripts/fetch-tier1-fixtures.ts",
    "audit:month-system": "npx tsx scripts/audit-month-system.ts",
    "council:packet": "npx tsx scripts/build-council-packet.ts",
    "derive:e13": "npx tsx scripts/derive-e13-longitude.ts",
    "launch:apply": "npx tsx scripts/apply-launch-set.ts",
    "generate:fallback": "npx tsx scripts/generate-festival-fallback.ts",
    "check:adhika": "npx tsx scripts/check-adhika.ts",
    "measure:ayanamsha-charts": "npx tsx scripts/measure-ayanamsha-charts.ts",
    "verify:materialisation-shadow": "bash scripts/shadow/verify-materialisation-shadow.sh",
    "verify:review-queue-shadow": "bash scripts/shadow/verify-review-queue-shadow.sh",
    "verify:council-approval-shadow": "bash scripts/shadow/verify-council-approval-shadow.sh",
    "verify:approved-calendar-pilot-shadow": "bash scripts/shadow/verify-approved-calendar-pilot-shadow.sh",
    "calendar:approved-fixtures:dry-run": "DOTENV_CONFIG_PATH=.env.local npx tsx scripts/materialize-approved-calendar-fixtures.mts",
    "calendar:approved-fixtures:commit": "DOTENV_CONFIG_PATH=.env.local npx tsx scripts/materialize-approved-calendar-fixtures.mts --commit",
    "calendar:approved-fixtures:rollback:dry-run": "DOTENV_CONFIG_PATH=.env.local npx tsx scripts/rollback-approved-calendar-fixtures.mts",
    "calendar:approved-fixtures:rollback:commit": "DOTENV_CONFIG_PATH=.env.local npx tsx scripts/rollback-approved-calendar-fixtures.mts --commit",
    "generate:library-summaries": "npx tsx scripts/generate-library-summaries.ts",
    "verify:vrat-observation-shadow": "bash scripts/shadow/verify-vrat-observation-shadow.sh",
    "audit:naraka": "npx tsx scripts/naraka-baseline-audit.mts",
    "verify:naraka-shadow": "bash scripts/shadow/verify-naraka-approval-shadow.sh",
    "verify:native-observance-series-contract": "node scripts/verify-native-observance-series-contract.mjs",
    "baseline:privacy": "npx tsx scripts/generate-privacy-security-baseline.ts",
    "generate:compliance-manifest": "node scripts/generate-compliance-evidence-manifest.mjs",
    "test:baseline:privacy": "npx tsx --test scripts/generate-privacy-security-baseline.test.ts",
    "test:web-consent": "npx tsx --test src/lib/web-consent.test.ts",
    "test:public-sources": "npx tsx --test src/lib/public-source-disclosures.test.ts",
    "test:mandali-write-contract": "npx vitest run src/lib/mandali-write-contract.test.ts",
    "verify:profiles-containment-shadow": "bash scripts/shadow/verify-profiles-containment-shadow.sh",
    "verify:compliance-engineering": "node scripts/verify-compliance-engineering.mjs",
    "verify:production-release": "node scripts/verify-production-release.mjs",
    "test:client-errors": "npx tsx --test src/lib/client-error-contract.test.ts"
  },
  "dependencies": {
    "@react-three/drei": "^9.121.5",
    "@react-three/fiber": "^8.17.14",
    "@sangam/pathshala-engine": "*",
    "@sangam/sadhana-engine": "*",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.97.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astronomia": "^4.2.0",
    "astronomy-engine": "^2.1.19",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.38.0",
    "geo-tz": "^8.1.7",
    "google-auth-library": "^10.6.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.383.0",
    "next": "^15.5.23",
    "razorpay": "^2.9.6",
    "react": "^18",
    "react-dom": "^18",
    "react-hot-toast": "^2.4.1",
    "react-leaflet": "^4.2.1",
    "tailwind-merge": "^2.4.0",
    "three": "^0.185.1",
    "twilio": "^6.0.2",
    "workflow": "^4.7.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.0.1",
    "critters": "^0.0.23",
    "dotenv": "^17.4.2",
    "eslint": "^8",
    "eslint-config-next": "15.5.23",
    "html-minifier-terser": "^7.2.0",
    "pg": "^8.23.0",
    "postcss": "^8",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "4.60.1",
    "@rollup/rollup-linux-x64-gnu": "4.60.1"
  },
  "overrides": {
    "scheduler": "^0.23.2"
  }
}
