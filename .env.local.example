# ─────────────────────────────────────────────────────────────────
# Sanatana Sangam — Environment Variables
# Copy this file to .env.local and fill in your Supabase credentials
# Get these from: https://supabase.com → Your Project → Settings → API
# ─────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Public canonical app origin used for OAuth redirect URLs in production.
# This exact origin must be present in Supabase Auth → URL Configuration
# redirect allow-list, including /auth/callback.
NEXT_PUBLIC_APP_URL=https://www.shoonaya.com

# Launched app default is open when unset. Set APP_OPEN=false only for a
# deliberate preview/maintenance gate.
APP_OPEN=true

# Optional: only needed for admin operations
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Public support email shown on the contact page
NEXT_PUBLIC_SUPPORT_EMAIL=

# Verified Google Play testing invitation used by /beta/android.
# Leave empty until the real beta URL is available; the website fails closed.
NEXT_PUBLIC_ANDROID_BETA_URL=

CRON_SECRET=YOUR_CRON_SECRET

# ─── Google Gemini (AI chat & Dharma AI) ──────────────────────────
# Get from: https://aistudio.google.com → Get API Key (free tier available)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash

# ─── Standalone Admin Auth ─────────────────────────────────────────
# Completely independent from Supabase. Only used by the /admin portal.
# Generate ADMIN_SECRET with: openssl rand -hex 32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
ADMIN_SECRET=YOUR_32_CHAR_HEX_SECRET

# ─── Social Publishing Studio (Instagram/Facebook/LinkedIn pipeline) ──
# Token encryption: generate each key with `openssl rand -base64 32`.
# See src/lib/marketing/social/token-crypto.ts for the rotation procedure.
SOCIAL_TOKEN_ENC_KEY_CURRENT_VERSION=1
SOCIAL_TOKEN_ENC_KEY_V1=YOUR_BASE64_32_BYTE_KEY

# Meta (Facebook Page + Instagram Business) OAuth app credentials.
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_OAUTH_REDIRECT_URI=https://www.shoonaya.com/api/admin/marketing/social/oauth/meta/callback

# LinkedIn organization-posting OAuth app credentials.
LINKEDIN_CLIENT_ID=YOUR_LINKEDIN_CLIENT_ID
LINKEDIN_CLIENT_SECRET=YOUR_LINKEDIN_CLIENT_SECRET
LINKEDIN_OAUTH_REDIRECT_URI=https://www.shoonaya.com/api/admin/marketing/social/oauth/linkedin/callback

# Bearer secret the pg_cron-scheduled tick uses to call
# /api/cron/social-pipeline-tick (also stored in Supabase Vault as
# 'social_pipeline_tick_secret' -- see the pg_cron migration). CRON_SECRET
# above is also accepted, matching notification-dispatch's convention.
SOCIAL_PIPELINE_TICK_SECRET=YOUR_SOCIAL_PIPELINE_TICK_SECRET
